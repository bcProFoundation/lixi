{
  "name": "@bcpros/redux-store",
  "version": "1.1.6",
  "description": "Models library for lixi application",
  "main": "build/main/index.js",
  "types": "build/main/index.d.ts",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/bcProFoundation/lixilotus/tree/master/packages/redux-store",
  "license": "MIT",
  "keywords": [],
  "exports": {
    ".": {
      "require": "./build/main/index.js",
      "import": "./dist/module/index.mjs"
    },
    "./*": {
      "require": "./build/main/*.js",
      "import": "./build/module/*.mjs"
    }
  },
  "scripts": {
    "build": "run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "precommit": "turbo run format",
    "fix": "run-s fix:*",
    "lint": "run-s lint:*",
    "lint:ts": "eslint src --ext .ts",
    "format": "prettier \"src/**/*.ts\" --write --config .prettierrc.js",
    "fix:lint": "eslint src --ext .ts --fix",
    "graphql-codegen": "graphql-codegen --config codegen.yml"
  },
  "engines": {
    "node": ">=10"
  },
  "peerDependencies": {
    "@abcpros/bitcore-lib-xpi": ">=8.25.37",
    "@bcpros/xpi-js": ">=4.0.0",
    "@prisma/client": ">=5.8.1",
    "antd": ">=5.15.3",
    "axios": ">=1.4.0",
    "chronik-client": ">=0.26.0",
    "file-saver": ">=2.0.5",
    "iron-session": ">=8.0.1",
    "moment": ">=2.30.1",
    "next": ">=12.3.1",
    "react": ">=17.0.0",
    "react-intl-universal": ">=2.11.1",
    "react-outside-call": ">=0.2.0",
    "react-redux": ">=9.1.0",
    "redux": ">=5.0.1",
    "redux-thunk": ">=3.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/near-operation-file-preset": "^3.0.0",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@graphql-codegen/typescript-rtk-query": "^3.1.1",
    "@graphql-typed-document-node/core": "^3.1.1",
    "@rtk-query/graphql-request-base-query": "^2.2.0",
    "@types/node": "^20.11.29",
    "@types/react": "18.2.67",
    "@types/react-dom": "18.2.22",
    "@types/react-redux": "^7.1.33",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.27.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.1",
    "types": "^0.1.1",
    "typescript": "5.4.2"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "rewritePaths": {
        "src/": "build/main/"
      }
    },
    "files": [
      "!build/module/**"
    ]
  },
  "prettier": {
    "singleQuote": true
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  },
  "dependencies": {
    "@bcpros/lixi-models": "^1.1.6",
    "@bcpros/minimal-xpi-slp-wallet": "3.0.10",
    "@nestjs/mapped-types": "^2.0.5",
    "@reduxjs/toolkit": "^2.2.1",
    "@shoooe/derive": "^0.2.7",
    "@socket.io/component-emitter": "3.1.0",
    "bignumber.js": "^9.0.0",
    "bitcoinjs-message": "^2.2.0",
    "class-validator": "^0.14.0",
    "connected-next-router": "^5.0.0",
    "ecashaddrjs": "^1.5.3",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "lodash": "^4.17.21",
    "next-redux-wrapper": ">=8.1.0",
    "node-forge": "^1.3.1",
    "prisma-graphql-type-decimal": "^3.0.0",
    "react-device-detect": "^2.2.2",
    "redux-persist": "^6.0.0",
    "redux-persist-indexeddb-storage": "^1.0.4",
    "redux-saga": "^1.3.0",
    "reselect": "^5.1.0",
    "socket.io-client": "^4.5.4",
    "ts-pattern": "^4.3.0",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1",
    "wif": ">=4.0.0"
  }
}