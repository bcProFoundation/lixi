{
  "name": "@bcpros/redux-store",
  "version": "1.2.18",
  "description": "Models library for lixi application",
  "main": "build/main/index.js",
  "types": "build/main/index.d.ts",
  "module": "build/module/index.mjs",
  "repository": "https://github.com/bcProFoundation/lixilotus/tree/master/packages/redux-store",
  "license": "MIT",
  "keywords": [],
  "exports": {
    ".": {
      "types": "./build/main/index.d.ts",
      "require": "./build/main/index.js",
      "import": "./dist/module/index.js",
      "default": "./build/main/index.js"
    },
    "./generated/*": {
      "types": "./build/main/generated/*.d.ts",
      "require": "./build/main/generated/*.js",
      "import": "./build/module/generated/*.js",
      "default": "./build/main/generated/*.js"
    },
    "./*": {
      "types": "./build/main/*.d.ts",
      "require": "./build/main/*.js",
      "import": "./build/module/*.js",
      "default": "./build/main/*.js"
    }
  },
  "scripts": {
    "build": "rimraf build && run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "precommit": "turbo run format",
    "fix": "run-s fix:*",
    "lint": "run-s lint:*",
    "lint:ts": "eslint src --ext .ts",
    "format": "prettier \"src/**/*.ts\" --write --config .prettierrc.js",
    "fix:lint": "eslint src --ext .ts --fix",
    "graphql-codegen": "graphql-codegen --config codegen.yml"
  },
  "peerDependencies": {
    "@abcpros/bitcore-lib-xpi": ">=8.25.37",
    "@bcpros/xpi-js": "4.0.6",
    "@prisma/client": "5.12.1",
    "@reduxjs/toolkit": "^2.2.1",
    "@rtk-query/graphql-request-base-query": "^2.2.0",
    "axios": ">=1.4.0",
    "chronik-client": "^0.26.2",
    "file-saver": ">=2.0.5",
    "iron-session": ">=8.0.1",
    "moment": "^2.30.1",
    "react": "18.2.0",
    "react-device-detect": "^2.2.2",
    "react-intl-universal": "^2.11.1",
    "react-outside-call": "^0.2.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-persist-indexeddb-storage": "^1.0.4",
    "redux-saga": "^1.3.0",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/near-operation-file-preset": "^3.0.0",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@graphql-codegen/typescript-rtk-query": "^3.1.1",
    "@graphql-typed-document-node/core": "^3.1.1",
    "@reduxjs/toolkit": "^2.2.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "18.2.22",
    "@types/react-redux": "^7.1.33",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "esbuild": "^0.21.4",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.27.5",
    "rimraf": "^5.0.5",
    "iron-session": ">=8.0.1",
    "npm-dts": "^1.3.12",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "react-device-detect": "^2.2.2",
    "redux-persist": "^6.0.0",
    "redux-persist-indexeddb-storage": "^1.0.4",
    "redux-saga": "^1.3.0",
    "ts-node": "^10.9.1",
    "ts-patch": "^3.1.2",
    "types": "^0.1.1",
    "typescript": "5.4.3",
    "typescript-transform-paths": "^3.4.7"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@bcpros/lixi-models": "workspace:*",
    "@bitgo/utxo-lib": "^9.34.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@shoooe/derive": "^0.2.7",
    "@socket.io/component-emitter": "3.1.0",
    "bignumber.js": "^9.0.0",
    "bitcoinjs-message": "^2.2.0",
    "bs58": "^5.0.0",
    "class-validator": "^0.14.0",
    "ecash-lib": "0.1.3",
    "ecashaddrjs": "^1.5.6",
    "ergonaddrjs": "^1.0.1",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.1",
    "prisma-graphql-type-decimal": "^3.0.0",
    "reselect": "^5.1.0",
    "socket.io-client": "^4.5.4",
    "ts-pattern": "^4.3.0",
    "unique-names-generator": "^4.7.1",
    "universal-cookie": "^7.1.4",
    "uuid": "^9.0.1",
    "wif": "^5.0.0"
  }
}
