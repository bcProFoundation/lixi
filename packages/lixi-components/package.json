{
  "name": "@bcpros/lixi-components",
  "version": "1.1.6",
  "main": "dist/index.ts",
  "main:src": "src/index.ts",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^5.3.4",
    "@babel/preset-typescript": "^7.24.1",
    "@testing-library/user-event": "^14.5.2",
    "@zxing/library": "0.20.0",
    "@zxing/browser": "^0.1.1",
    "antd": "^5.15.3",
    "bignumber.js": "^9.0.0",
    "browserify-zlib": "^0.2.0",
    "lodash": "^4.17.21",
    "next": "^14.1.4",
    "qrcode.react": "^3.1.0",
    "react": "18.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "18.2.0",
    "rimraf": "^5.0.5",
    "stream-browserify": "^3.0.0",
    "styled-components": "^6.1.8",
    "typescript": "5.4.3",
    "web-vitals": "^3.5.2"
  },
  "scripts": {
    "start": "yarn storybook",
    "prebuild": "rimraf dist",
    "build": "webpack --mode=production",
    "prepublish": "yarn build",
    "test": "jest",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public",
    "precommit": "yarn fix && yarn lint",
    "fix": "run-s fix:*",
    "lint": "run-s lint:*",
    "lint:ts": "eslint src --ext .ts",
    "lint:prettier": "prettier \"src/**/*.ts\" --check --config .prettierrc.js",
    "fix:prettier": "prettier \"src/**/*{.ts,.tsx}\" --write --config .prettierrc.js",
    "fix:lint": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "lixi-components",
    "bitcoin abc",
    "lotus",
    "XPI",
    "react components",
    "crypto faucet"
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.0.2",
    "@storybook/addon-controls": "^8.0.2",
    "@storybook/addon-essentials": "^8.0.2",
    "@storybook/addon-knobs": "^7.0.2",
    "@storybook/addon-links": "^8.0.2",
    "@storybook/addons": "^7.6.17",
    "@storybook/node-logger": "^8.0.2",
    "@storybook/react": "^8.0.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.30",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^18.2.67",
    "@types/react-dom": "18.2.22",
    "@types/styled-components": "^5.1.34",
    "babel-jest": "^29.7.0",
    "babel-plugin-styled-components": "^2.1.4",
    "jest-environment-jsdom-fifteen": "^1.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jest-environment-jsdom-fifteen",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      ".+\\.(css|styl|less|sass|scss|png|jpg|svg|ttf|woff|woff2)$": "identity-obj-proxy"
    }
  }
}