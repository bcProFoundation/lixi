{
  "extends": "./tsconfig.path.json",
  "compilerOptions": {
    "traceResolution": false,
    "noErrorTruncation": false,
    "baseUrl": ".",
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "preserve",
    "noImplicitAny": false,
    "composite": true,
    "incremental": true,
    "experimentalDecorators": true
  },
  "noErrorTruncation": true,
  "references": [
    {
      "path": "../redux-store/tsconfig.json"
    }
  ],
  "include": [
    "src/**/*",
    "src/@types/service-workder.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "typeRoots": [
    "./src/@types",
    "./node_modules/@types"
  ],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}