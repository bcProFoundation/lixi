# Production Environment Configuration
# Use this configuration for production deployments

DEPLOY_ENVIRONMENT=production

# BITCORE/FIAT RATE API
# Primary: Use prod endpoint
BITCORE_URL=https://aws.abcpay.cash/bws/api
# Fallback: Use dev endpoint if prod fails
BITCORE_URL_FALLBACK=https://aws-dev.abcpay.cash/bws/api

# You can specify multiple fallbacks separated by commas:
# BITCORE_URL_FALLBACK=https://aws-dev.abcpay.cash/bws/api,https://backup.abcpay.cash/bws/api
