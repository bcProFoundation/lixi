# Telegram Error Notifications (separate bot for each environment)
# Bot token for error notifications - CREATE SEPARATE BOTS for dev/staging/prod
# To create a bot: chat with @BotFather on Telegram, use /newbot command
# Dev bot example: MyApp_Dev_Errors_Bot
# Prod bot example: MyApp_Prod_Errors_Bot
TELEGRAM_ERROR_NOTIFICATION_BOT_TOKEN=

# Chat ID for receiving error notifications (use @userinfobot to get your chat ID or group ID)
# Examples:
# - For private chat: your user ID (e.g., 123456789)
# - For group: group ID (e.g., -1001234567890)
# - For channel: channel ID (e.g., -1001234567890)
# Leave empty to disable error notifications
TELEGRAM_ERROR_NOTIFICATION_CHAT_ID=

# BITCORE/FIAT RATE API (legacy, kept as fallback during CMC migration)
# Primary endpoint
BITCORE_URL=https://aws-dev.abcpay.cash/bws/api
# Fallback endpoints (comma-separated, tried in order if primary fails)
# Example: BITCORE_URL_FALLBACK=https://aws.abcpay.cash/bws/api,https://backup.abcpay.cash/bws/api
BITCORE_URL_FALLBACK=https://aws.abcpay.cash/bws/api

# Fiat rate provider: cmc-oer (default) | cmc | legacy
# - cmc-oer: CoinMarketCap crypto prices + Open Exchange Rates forex (recommended)
# - cmc: CoinMarketCap only (direct quotes, no forex-derived long tail)
# - legacy: Bitcore/abcpay endpoints only
FIAT_RATE_PROVIDER=cmc-oer
# Set to false to disable legacy Bitcore fallback when CMC/OER fails
FIAT_RATE_LEGACY_FALLBACK_ENABLED=true
FIAT_RATE_MIN_MAJOR_CURRENCIES=3

# CoinMarketCap (Phase 1: XEC-USD on free Basic; Phase 2+: multi-fiat on Builder)
# Get a key at https://pro.coinmarketcap.com (Basic free tier includes commercial use)
CMC_API_KEY=
CMC_API_URL=https://pro-api.coinmarketcap.com
# Coins priced via CMC (must have IDs in CMC_COIN_IDS or defaults)
CMC_COINS=XEC,BTC,BCH,ETH,DOGE,XRP,LTC,USDT,USDC
# Optional override: SYMBOL:ID pairs (defaults cover the coins above)
#CMC_COIN_IDS=XEC:10791,BTC:1,BCH:1831,ETH:1027,DOGE:74,XRP:52,LTC:2,USDT:825,USDC:3408
# Max fiat converts per CMC call: 1 on Basic (free), 8 on Builder, 40 on Startup
CMC_CONVERT_LIMIT=1

# Tiered fiat refresh (direct CMC quotes; others derived via OER forex)
FIAT_RATE_HOT_FIATS=USD,EUR,VND,IDR,NGN,PHP,BRL,INR
FIAT_RATE_WARM_FIATS=GBP,JPY,AUD,CAD,CHF,CNY,KRW,MXN,THB,MYR,ZAR,TRY,UAH,SGD,HKD,AED
FIAT_RATE_HOT_TTL=600
FIAT_RATE_WARM_TTL=7200
FIAT_RATE_MERGED_TTL=300

# Open Exchange Rates (Phase 2: USD->fiat matrix for long-tail derivation)
# Developer plan ($12/mo) covers commercial use; https://openexchangerates.org
OER_APP_ID=
OER_API_URL=https://openexchangerates.org/api
OER_TTL=3600

TELEGRAM_MINI_APP_ENABLED=true