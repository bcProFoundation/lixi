# Development Environment Configuration
# Copy this to .env for local development

DEPLOY_ENVIRONMENT=development

# BITCORE/FIAT RATE API
# Primary: Use dev endpoint
BITCORE_URL=https://aws-dev.abcpay.cash/bws/api
# Fallback: Use prod endpoint if dev fails
BITCORE_URL_FALLBACK=https://aws.abcpay.cash/bws/api

# You can specify multiple fallbacks separated by commas:
# BITCORE_URL_FALLBACK=https://aws.abcpay.cash/bws/api,https://backup.abcpay.cash/bws/api
