{
  "name": "@bcpros/lixi-models",
  "version": "1.2.22",
  "description": "Models library for lixi application",
  "main": "build/main/index.js",
  "types": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/bcProFoundation/lixilotus/tree/master/packages/lixi-models",
  "license": "MIT",
  "keywords": [],
  "exports": {
    ".": {
      "types": "./build/main/index.d.ts",
      "require": "./build/main/index.js",
      "import": "./build/module/index.js",
      "default": "./build/main/index.js"
    },
    "./constants/coins/*": {
      "types": "./build/main/constants/coins/*.d.ts",
      "require": "./build/main/constants/coins/*.js",
      "import": "./build/module/constants/coins/*.js",
      "default": "./build/main/constants/coins/*.js"
    },
    "./constants/*": {
      "types": "./build/main/constants/*.d.ts",
      "require": "./build/main/constants/*.js",
      "import": "./build/module/constants/*.js",
      "default": "./build/main/constants/*.js"
    },
    "./lib/*": {
      "types": "./build/main/lib/*.d.ts",
      "require": "./build/main/lib/*.js",
      "import": "./build/module/lib/*.js",
      "default": "./build/main/lib/*.js"
    },
    "./lib/burn/*": {
      "types": "./build/main/lib/burn/*.d.ts",
      "require": "./build/main/lib/burn/*.js",
      "import": "./build/module/lib/burn/*.js",
      "default": "./build/main/lib/burn/*.js"
    }
  },
  "scripts": {
    "build": "rimraf build && run-p build:*",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "precommit": "turbo run format",
    "fix": "run-s fix:*",
    "lint": "run-s lint:*",
    "lint:ts": "eslint src --ext .ts",
    "lint:prettier": "prettier \"src/**/*.ts\" --check --config .prettierrc.js",
    "format": "prettier \"src/**/*.ts\" --write --config .prettierrc.js",
    "fix:lint": "eslint src --ext .ts --fix"
  },
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "@prisma/client": "5.12.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/graphql": "^12.1.1",
    "@prisma/client": "5.12.1",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "chronik-client": "^0.26.2",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.27.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "ts-morph": "^22.0.0",
    "ts-node": "^10.9.1",
    "typescript": "5.4.3",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "rewritePaths": {
        "src/": "build/main/"
      }
    },
    "files": [
      "!build/module/**"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  },
  "dependencies": {
    "@nestjs/mapped-types": "^2.0.5",
    "bignumber.js": "^9.0.0",
    "class-validator": "^0.14.0",
    "graphql-scalars": "^1.23.0",
    "moment": "^2.30.1",
    "os-browserify": "^0.3.0",
    "prisma-graphql-type-decimal": "^3.0.0"
  }
}