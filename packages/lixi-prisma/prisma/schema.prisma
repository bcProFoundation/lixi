datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Handle {
  id          String @id @default(cuid())
  network     Coin   @default(XPI)
  name        String @map("name") @db.VarChar(150)
  address     String @default("") @map("address")
  blockHeight Int    @map("block_height")
  status      String @default("pending")
  txid        String

  @@index([name])
  @@index([address])
  @@index([address, txid])
  @@map("handle")
}

model Token {
  id                   String       @id @default(cuid())
  tokenId              String       @unique @map("token_id")
  tokenType            String       @default("") @map("token_type") @db.VarChar(255)
  name                 String       @default("") @map("name") @db.VarChar(255)
  ticker               String       @default("") @map("ticker") @db.VarChar(255)
  decimals             Int          @map("decimals")
  tokenDocumentUrl     String       @default("") @map("token_document_url") @db.VarChar(1000)
  totalBurned          String       @default("") @map("total_burned")
  totalMinted          String       @default("") @map("total_minted")
  initialTokenQuantity String       @default("") @map("initial_token_quantity")
  comments             DateTime?    @default(now()) @map("comments") @db.Timestamptz
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdDate          DateTime     @default(now()) @map("created_date") @db.Timestamptz
  posts                Post[]
  followers            FollowPage[]
  dana                 TokenDana?

  @@map("token")
}

model TokenDana {
  danaReceivedUp    Float  @default(0.0) @map("dana_received_up")
  danaReceivedDown  Float  @default(0.0) @map("dana_received_down")
  danaReceivedScore Float  @default(0.0) @map("dana_received_score")
  danaBurnUp        Float  @default(0.0) @map("dana_burn_up")
  danaBurnDown      Float  @default(0.0) @map("dana_burn_down")
  danaBurnScore     Float  @default(0.0) @map("dana_burn_score")
  token             Token  @relation(fields: [tokenId], references: [id])
  tokenId           String @unique @map("token_id")
  version           Int    @default(0)

  @@index([tokenId])
  @@map("token_dana")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @default("") @map("name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  pages     Page[]
  Product   Product[]

  @@map("category")
}

model Page {
  id                          String               @id @default(cuid())
  pageAccount                 Account              @relation(fields: [pageAccountId], references: [id])
  pageAccountId               Int                  @map("page_account_id")
  name                        String               @default("") @map("name") @db.VarChar(255)
  title                       String               @default("") @map("title") @db.VarChar(255)
  category                    Category?            @relation(fields: [categoryId], references: [id])
  categoryId                  Int?                 @map("category_id")
  description                 String               @default("") @map("description") @db.VarChar(1000)
  children                    Page[]               @relation("subPages")
  parent                      Page?                @relation("subPages", fields: [parentId], references: [id])
  parentId                    String?              @map("parent_id")
  website                     String               @default("") @map("website")
  avatar                      UploadDetail?        @relation("PageAvatar")
  cover                       UploadDetail?        @relation("PageCover")
  country                     Country?             @relation(fields: [countryId], references: [id])
  countryId                   Int?                 @map("country_id")
  state                       State?               @relation(fields: [stateId], references: [id])
  stateId                     Int?                 @map("state_id")
  address                     String               @default("") @map("address")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime             @default(now()) @map("updated_at") @db.Timestamptz
  danaBurnUp                  Float                @default(0.0) @map("dana_burn_up")
  danaBurnDown                Float                @default(0.0) @map("dana_burn_down")
  danaBurnScore               Float                @default(0.0) @map("dana_burn_score")
  createPostFee               String               @default("1.0") @map("create_post_fee")
  createCommentFee            String               @default("Dust") @map("create_comment_fee")
  encryptedMnemonic           String?              @map("encrypted_mnemonic")
  salt                        String?              @map("salt") @db.VarChar(10)
  totalPostsBurnUp            Float                @default(0.0) @map("total_posts_burn_up")
  totalPostsBurnDown          Float                @default(0.0) @map("total_posts_burn_down")
  totalPostsBurnScore         Float                @default(0.0) @map("total_posts_burn_score")
  pageMessageSessions         PageMessageSession[]
  accessMessageFee            Float?               @default(0.0) @map("access_message_fee")
  minDanaForMessage           Float?               @default(0.0) @map("min_dana_for_message")
  followerFreeMessage         Boolean?             @default(false) @map("follower_free_message")
  pageAvatarImageUploadable   ImageUploadable?     @relation("page_avatar_image_uploadable", fields: [pageAvatarImageUploadableId], references: [id])
  pageAvatarImageUploadableId String?              @unique @map("page_avatar_image_uploadable_id")
  pageCoverImageUploadable    ImageUploadable?     @relation("page_cover_image_uploadable", fields: [pageCoverImageUploadableId], references: [id])
  pageCoverImageUploadableId  String?              @unique @map("page_cover_image_uploadable_id")
  dana                        PageDana?
  posts                       Post[]
  followers                   FollowPage[]

  @@index([pageAccountId])
  @@map("page")
}

model PageDana {
  danaReceivedUp    Float  @default(0.0) @map("dana_received_up")
  danaReceivedDown  Float  @default(0.0) @map("dana_received_down")
  danaReceivedScore Float  @default(0.0) @map("dana_received_score")
  danaBurnUp        Float  @default(0.0) @map("dana_burn_up")
  danaBurnDown      Float  @default(0.0) @map("dana_burn_down")
  danaBurnScore     Float  @default(0.0) @map("dana_burn_score")
  page              Page   @relation(fields: [pageId], references: [id])
  pageId            String @unique @map("page_id")
  version           Int    @default(0)

  @@index([pageId])
  @@map("page_dana")
}

model Post {
  id                String            @id @default(cuid())
  account           Account           @relation(fields: [accountId], references: [id])
  accountId         Int               @map("account_id")
  page              Page?             @relation(fields: [pageId], references: [id])
  pageId            String?           @map("page_id")
  token             Token?            @relation(fields: [tokenId], references: [id])
  tokenId           String?           @map("token_id")
  content           String            @default("")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  uploads           UploadDetail[]    @relation("PostImages")
  danaBurnUp        Float             @default(0.0) @map("dana_burn_up")
  danaBurnDown      Float             @default(0.0) @map("dana_burn_down")
  danaBurnScore     Float             @default(0.0) @map("dana_burn_score")
  postHashtags      PostHashtag[]
  createFee         Float?            @map("create_fee")
  txid              String?
  reposts           Repost[]
  lastRepostAt      DateTime          @default(now()) @map("updated_repost_at") @db.Timestamptz
  originalLanguage  String?           @map("original_language")
  translations      PostTranslation[]
  commentableId     String?           @unique @map("commentable_id")
  commentable       Commentable?      @relation(fields: [commentableId], references: [id])
  bookmarkableId    String?           @unique @map("bookmarkable_id")
  bookmarkable      Bookmarkable?     @relation(fields: [bookmarkableId], references: [id])
  taggableId        String?
  taggable          Taggable?         @relation(fields: [taggableId], references: [id])
  imageUploadable   ImageUploadable?  @relation("post_image_uploadable", fields: [imageUploadableId], references: [id])
  imageUploadableId String?           @unique @map("post_image_uploadable_id")
  type              PostType          @default(value: POST) @map("type")
  dana              PostDana?
  event             Event?
  poll              Poll?
  product           Product?
  offer             Offer?
  boostScore        PostBoostScore?

  @@index([commentableId])
  @@index([accountId])
  @@index([pageId])
  @@map("post")
}

model PostDana {
  danaReceivedUp    Float  @default(0.0) @map("dana_received_up")
  danaReceivedDown  Float  @default(0.0) @map("dana_received_down")
  danaReceivedScore Float  @default(0.0) @map("dana_received_score")
  danaBurnUp        Float  @default(0.0) @map("dana_burn_up")
  danaBurnDown      Float  @default(0.0) @map("dana_burn_down")
  danaBurnScore     Float  @default(0.0) @map("dana_burn_score")
  post              Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId            String @unique @map("post_id")
  version           Int    @default(0)

  @@index([postId])
  @@map("post_dana")
}

model PostBoostScore {
  boostReceivedUp    Float  @default(0.0) @map("boost_received_up")
  boostReceivedDown  Float  @default(0.0) @map("boost_received_down")
  boostReceivedScore Float  @default(0.0) @map("boost_received_score")
  boostUp            Float  @default(0.0) @map("boost_up")
  boostDown          Float  @default(0.0) @map("boost_down")
  boostScore         Float  @default(0.0) @map("boost_score")
  post               Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId             String @unique @map("post_id")
  version            Int    @default(0)

  @@index([postId])
  @@map("post_boost_score")
}

enum PostType {
  POST
  EVENT
  POLL
  PRODUCT
  OFFER

  @@map("post_type")
}

enum CommentType {
  POST
  EVENT
  POLL
  PRODUCT
  OFFER

  @@map("comment_type")
}

model Commentable {
  id       String      @id @default(cuid())
  type     CommentType @default(value: POST) @map("type")
  comments Comment[]
  post     Post?

  @@map("commentable")
}

model Comment {
  id                 String           @id @default(cuid())
  commentAccount     Account?         @relation(fields: [commentAccountId], references: [id])
  commentAccountId   Int?             @map("comment_account_id")
  commentByPublicKey String?          @map("comment_by_public_key")
  commentToId        String           @map("comment_to_id")
  commentableId      String?          @map("commentable_id")
  commentable        Commentable?     @relation(fields: [commentableId], references: [id])
  commentText        String           @default("") @map("comment_text")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  danaBurnUp         Float            @default(0.0) @map("dana_burn_up")
  danaBurnDown       Float            @default(0.0) @map("dana_burn_down")
  danaBurnScore      Float            @default(0.0) @map("dana_burn_score")
  giveTip            GiveTip?
  createFee          Float?           @map("create_fee")
  txid               String?
  imageUploadable    ImageUploadable? @relation("comment_image_uploadable", fields: [imageUploadableId], references: [id])
  imageUploadableId  String?          @unique @map("comment_image_uploadable_id")
  commentDana        CommentDana?
  parentId           String?
  parent             Comment?         @relation("ParentChildren", fields: [parentId], references: [id])
  children           Comment[]        @relation("ParentChildren")
  rootId             String?

  @@index([commentableId], map: "index_commentable")
  @@index([commentAccountId], map: "index_comment_on_account")
  @@index([commentByPublicKey], map: "index_comment_by_public_key")
  @@index([commentToId], map: "index_comment_on_post")
  @@map("comment")
}

model CommentDana {
  danaBurnUp    Float   @default(0.0) @map("dana_burn_up")
  danaBurnDown  Float   @default(0.0) @map("dana_burn_down")
  danaBurnScore Float   @default(0.0) @map("dana_burn_score")
  comment       Comment @relation(fields: [commentId], references: [id])
  commentId     String  @unique @map("comment_id")
  version       Int     @default(0)

  @@index([commentId])
  @@map("comment_dana")
}

model Account {
  id                             Int                   @id @default(autoincrement())
  name                           String
  encryptedMnemonic              String?               @map("encrypted_mnemonic")
  encryptedSecret                String?               @default("") @map("encrypted_secret")
  createdAt                      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  lixies                         Lixi[]
  mnemonicHash                   String?               @map("mnemonic_hash")
  address                        String                @default("") @map("address")
  hash160                        Bytes                 @default("") @map("hash_160")
  notifications                  Notification[]
  language                       String                @default("en")
  secondaryLanguage              String?               @map("secondary_language")
  publicKey                      String                @default("") @map("public_key")
  email                          String?               @unique
  uploadDetail                   UploadDetail[]
  pages                          Page[]
  posts                          Post[]
  comments                       Comment[]
  Worship                        Worship[]
  temples                        Temple[]
  followers                      FollowAccount[]       @relation("followerAccount")
  followings                     FollowAccount[]       @relation("followingAccount")
  followingPages                 FollowPage[]
  webpushSubscribers             WebpushSubscriber[]
  reposts                        Repost[]
  messages                       Message[]
  pageMessageSessions            PageMessageSession[]
  accountDana                    AccountDana?
  avatar                         UploadDetail?         @relation("avatar")
  cover                          UploadDetail?         @relation("cover")
  description                    String                @default("") @map("description") @db.VarChar(1000)
  dayOfBirth                     Int?                  @map("day_of_birth")
  monthOfBirth                   Int?                  @map("month_of_birth")
  yearOfBirth                    Int?                  @map("year_of_birth")
  website                        String                @default("") @map("website")
  createCommentFee               String                @default("Dust") @map("create_comment_fee")
  accountAvatarImageUploadable   ImageUploadable?      @relation("account_avatar_image_uploadable", fields: [accountAvatarImageUploadableId], references: [id])
  accountAvatarImageUploadableId String?               @unique @map("account_avatar_image_uploadable_id")
  accountCoverImageUploadable    ImageUploadable?      @relation("account_cover_image_uploadable", fields: [accountCoverImageUploadableId], references: [id])
  accountCoverImageUploadableId  String?               @unique @map("account_cover_image_uploadable_id")
  bookmarks                      Bookmark[]
  imageUploadable                ImageUploadable[]
  PollAnswerOnAccount            PollAnswerOnAccount[]
  walletPaths                    WalletPath[]
  role                           Role                  @default(USER)
  telegramId                     String?               @unique @map("telegram_id")
  telegramUsername               String?               @map("telegram_username")
  escrowSellOrders               EscrowOrder[]         @relation("escrow_sell_orders")
  escrowBuyOrders                EscrowOrder[]         @relation("escrow_buy_orders")
  escrowArbiOrders               EscrowOrder[]         @relation("escrow_arbi_orders")
  escrowModOrders                EscrowOrder[]         @relation("escrow_mod_orders")

  @@index([mnemonicHash], type: Hash)
  @@map("account")
}

enum Role {
  MODERATOR
  ARBITRATOR
  USER
}

model AccountDana {
  id                 String               @id @default(cuid())
  account            Account              @relation(fields: [accountId], references: [id])
  accountId          Int                  @unique @map("account_id")
  danaGiven          Float                @default(0.0) @map("dana_given")
  danaReceived       Float                @default(0.0) @map("dana_received")
  danaBurnUp         Float                @default(0.0) @map("dana_burn_up")
  danaBurnDown       Float                @default(0.0) @map("dana_burn_down")
  danaBurnScore      Float                @default(0.0) @map("dana_burn_score")
  danaReceivedUp     Float                @default(0.0) @map("dana_received_up")
  danaReceivedDown   Float                @default(0.0) @map("dana_received_down")
  danaReceivedScore  Float                @default(0.0) @map("dana_received_score")
  accountDanaHistory AccountDanaHistory[]
  version            Int                  @default(0)

  @@index([accountId])
  @@map("account_dana")
}

model AccountDanaHistory {
  id                String                  @id @default(cuid())
  accountDana       AccountDana?            @relation(fields: [accountDanaId], references: [id])
  accountDanaId     String?
  txid              String
  burnType          BurnType                @map("burn_type")
  burnForType       Int                     @map("burn_for_type")
  burnForId         String                  @map("burned_for_id")
  givenUpValue      Float?                  @default(0.0) @map("given_up_value")
  givenDownValue    Float?                  @default(0.0) @map("given_down_value")
  receivedUpValue   Float?                  @default(0.0) @map("received_up_value")
  receivedDownValue Float?                  @default(0.0) @map("received_down_value")
  type              AccountDanaHistoryType? @map("type")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz

  @@map("account_dana_history")
}

enum BurnType {
  UPVOTE
  DOWNVOTE
}

enum AccountDanaHistoryType {
  GIVEN
  RECEIVED
}

model Lixi {
  id                   Int                 @id @default(autoincrement())
  name                 String
  maxClaim             Int                 @default(0) @map("max_claim")
  claimedNum           Int                 @default(0) @map("claimed_num")
  claimType            Int                 @default(0) @map("claim_type")
  lixiType             Int                 @default(0) @map("lixi_type")
  minValue             Float               @map("min_value")
  maxValue             Float               @map("max_value")
  fixedValue           Float               @map("fixed_value")
  dividedValue         Int                 @default(1) @map("divided_value")
  encryptedXPriv       String              @map("encrypted_xpriv")
  encryptedClaimCode   String              @map("encrypted_claim_code")
  totalClaim           BigInt              @default(0) @map("total_claim")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  minStaking           Float               @default(0) @map("min_staking")
  expiryAt             DateTime?           @map("expiry_at") @db.Timestamptz
  activationAt         DateTime?           @map("activation_at") @db.Timestamptz
  country              String?             @map("country")
  isFamilyFriendly     Boolean             @map("is_family_friendly")
  claims               Claim[]
  joinLotteryProgram   Boolean             @default(false) @map("join_lottery_program")
  status               String              @default("active") @map("status")
  previousStatus       String              @default("active") @map("previous_status")
  inventoryStatus      String              @default("initialized") @map("invetory_status")
  account              Account             @relation(fields: [accountId], references: [id])
  accountId            Int                 @map("account_id")
  derivationIndex      Int                 @default(0) @map("derivation_index")
  address              String              @map("address")
  amount               Float               @default(0) @map("amount")
  numberOfSubLixi      Int?                @map("sub_lixi_value")
  parent               Lixi?               @relation("parentSubLixi", fields: [parentId], references: [id])
  subLixies            Lixi[]              @relation("parentSubLixi")
  parentId             Int?                @map("parent_id")
  envelopeId           Int?                @map("envelope_id")
  envelope             Envelope?           @relation(fields: [envelopeId], references: [id])
  envelopeMessage      String              @default("") @map("envelope_message")
  isClaimed            Boolean?            @default(false) @map("check_claim")
  isNFTEnabled         Boolean             @default(false) @map("is_nft_enabled")
  numberLixiPerPackage Int?                @map("number_lixi_per_package")
  packageId            Int?                @map("package_id")
  package              Package?            @relation(fields: [packageId], references: [id])
  distributions        LixiDistribution[]
  uploadDetail         UploadDetail?
  uploadDetailId       String?             @map("upload_detail_id")
  networkType          String              @default("single-ip") @map("network_type")
  pageMessageSession   PageMessageSession?
  imageUploadable      ImageUploadable?    @relation("lixi_image_uploadable", fields: [imageUploadableId], references: [id])
  imageUploadableId    String?             @unique @map("lixi_image_uploadable_id")

  @@map("lixi")
}

model Claim {
  id            Int      @id @default(autoincrement())
  ipaddress     String   @map("ip_address")
  transactionId String   @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz
  claimAddress  String   @map("claim_address")
  amount        BigInt   @map("amount")
  lixi          Lixi     @relation(fields: [lixiId], references: [id])
  lixiId        Int      @map("lixi_id")
  nftTokenId    String?  @map("nft_token_id")
  nftTokenUrl   String   @default("") @map("nft_token_url")

  @@map("claim")
}

model Envelope {
  id          Int      @id @default(autoincrement())
  name        String   @map("name")
  thumbnail   String   @map("thumbnail")
  image       String   @map("image")
  slug        String   @map("slug")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz
  description String   @default("") @map("description")
  Lixi        Lixi[]

  @@map("envelope")
}

model Package {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  lixi       Lixi[]
  registrant String?  @map("registrant")

  @@map("package")
}

model LixiDistribution {
  id               String @id @default(cuid())
  address          String @map("address")
  distributionType String @map("type")
  lixiId           Int
  lixi             Lixi   @relation(fields: [lixiId], references: [id])

  @@map("lixi_distribution")
}

model NotificationType {
  id                           Int                           @id @default(autoincrement())
  name                         String                        @default("")
  description                  String
  notifications                Notification[]
  notificationTypeTranslations NotificationTypeTranslation[]
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime                      @default(now()) @map("updated_at") @db.Timestamptz

  @@map("notification_type")
}

model NotificationTypeTranslation {
  id                 Int              @id @default(autoincrement())
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id])
  notificationTypeId Int              @map("notification_type_id")
  language           String
  isDefault          Boolean?         @map("is_default")
  template           String
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  @@map("notification_type_translation")
}

model Notification {
  id                 String            @id @default(cuid())
  message            String            @default("")
  readAt             DateTime?         @db.Timestamptz
  deletedAt          DateTime?         @db.Timestamptz
  senderId           Int?              @map("sender_id")
  additionalData     Json?             @map("additional_data")
  notificationType   NotificationType  @relation(fields: [notificationTypeId], references: [id])
  notificationTypeId Int               @map("type_id")
  level              NotificationLevel
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  status             String            @default("pending")
  recipient          Account?          @relation(fields: [recipientId], references: [id])
  recipientId        Int?              @map("recipient_id")
  url                String?
  action             String?

  @@map("notification")
}

model WebpushSubscriber {
  id             String    @id @default(cuid())
  clientAppId    String    @map("client_app_id")
  auth           String
  p256dh         String
  endpoint       String
  deviceId       String    @map("device_id")
  account        Account?  @relation(fields: [accountId], references: [id])
  accountId      Int?      @map("account_id")
  address        String
  expirationTime DateTime? @map("expiration_time") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([endpoint, p256dh, auth])
  @@index([endpoint])
  @@index([address])
  @@index([deviceId])
  @@map("webpush_subscription")
}

