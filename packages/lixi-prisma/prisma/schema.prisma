  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flag")
}

model Bookmarkable {
  id        String       @id @default(cuid())
  type      BookmarkType
  bookmarks Bookmark[]
  post      Post?

  @@map("bookmarkable")
}

enum BookmarkType {
  POST
  POLL
  EVENT
  PRODUCT
  COMMENT
}

model Bookmark {
  id             String        @id @default(cuid())
  account        Account       @relation(fields: [accountId], references: [id])
  accountId      Int           @map("account_id")
  bookmarkableId String?       @map("bookmarkable_id")
  bookmarkable   Bookmarkable? @relation(fields: [bookmarkableId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  @@map("bookmark")
}

model Event {
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String    @unique
  name        String
  description String?
  startDate   DateTime  @map("start_date") @db.Timestamptz
  endDate     DateTime  @map("end_date") @db.Timestamptz
  location    String?
  eventType   EventType // Add this field to specify event type (virtual or physical)

  @@index([postId])
  @@map("event")
}

enum EventType {
  VIRTUAL
  PHYSICAL
}

model PollOption {
  id                  String                @id @default(cuid())
  poll                Poll                  @relation(fields: [pollId], references: [postId])
  pollId              String                @map("poll_id")
  option              String
  pollAnswerOnAccount PollAnswerOnAccount[]

  @@map("poll_option")
}

model PollAnswerOnAccount {
  account       Account    @relation(fields: [accountId], references: [id])
  accountId     Int        @map("account_id")
  pollOptionId  String     @map("poll_option_id")
  pollOption    PollOption @relation(fields: [pollOptionId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  pollDanaScore Float      @default(0.0) @map("poll_dana_score")

  @@id([pollOptionId, accountId])
  @@map("pollawnswer_on_account")
}

model Poll {
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String       @unique
  question     String
  options      PollOption[] // Reference to the PollOption model
  startDate    DateTime     @map("start_date") @db.Timestamptz
  endDate      DateTime     @map("end_date") @db.Timestamptz
  singleSelect Boolean      @default(true) @map("single_select")
  canAddOption Boolean      @default(false) @map("can_add_option")

  @@index([postId])
  @@map("poll")
}

model Product {
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String    @unique
  title       String    @default("") @map("title") @db.VarChar(255)
  price       Float     @default(0.0) @map("price")
  priceUnit   String    @default("VND") @map("price_unit")
  phoneNumber String    @default("") @map("phone_number")
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?      @map("category_id")
  description String    @default("") @map("description") @db.VarChar(1000)
  country     Country?  @relation(fields: [countryId], references: [id])
  countryId   Int?      @map("country_id")
  state       State?    @relation(fields: [stateId], references: [id])
  stateId     Int?      @map("state_id")
  address     String?   @default("") @map("address")

  @@index([postId])
  @@map("product")
}

model WalletPath {
  id        String      @id @default(cuid())
  path      String
  address   String
  hash160   String
  type      AddressType
  publicKey String      @map("public_key")
  accountId Int         @map("account_id")
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  network   Coin        @default(XPI)

  @@map("wallet_path")
}

model EscrowOrder {
  id                  String            @id @default(cuid())
  sellerAccount       Account           @relation("escrow_sell_orders", fields: [sellerAccountId], references: [id])
  sellerAccountId     Int               @map("seller_account_id")
  buyerAccount        Account           @relation("escrow_buy_orders", fields: [buyerAccountId], references: [id])
  buyerAccountId      Int               @map("buyer_account_id")
  arbitratorAccount   Account           @relation("escrow_arbi_orders", fields: [arbitratorAccountId], references: [id])
  arbitratorAccountId Int               @map("arbitrator_account_id")
  moderatorAccount    Account           @relation("escrow_mod_orders", fields: [moderatorAccountId], references: [id])
  moderatorAccountId  Int               @map("moderator_account_id")
  escrowAddress       String            @unique @map("escrow_address")
  escrowTxids         EscrowTxId[]
  releaseTxid         String?           @unique @map("release_txid")
  returnTxid          String?           @unique @map("return_txid")
  paymentMethod       PaymentMethod     @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId     Int               @map("payment_method_id")
  message             String?
  price               Float             @default(0.0) @map("price")
  amount              Float             @default(0.0) @map("amount")
  offer               Offer             @relation(fields: [offerId], references: [postId])
  offerId             String            @map("offer_id")
  status              EscrowOrderStatus @default(PENDING)
  escrowScript        Bytes             @unique @map("escrow_script")
  nonce               String            @unique @map("nonce")
  dispute             Dispute?
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  @@map("escrow_order")
}

model EscrowTxId {
  txid          String      @unique
  outIdx        Int
  value         BigInt
  escrowOrder   EscrowOrder @relation(fields: [escrowOrderId], references: [id])
  escrowOrderId String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz
}

model Dispute {
  id            String        @id @default(cuid())
  escrowOrder   EscrowOrder   @relation(fields: [escrowOrderId], references: [id])
  escrowOrderId String        @unique @map("escrow_order_id")
  createdBy     String        @map("created_by")
  reason        String?
  status        DisputeStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  @@map("dispute")
}

model Offer {
  post           Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String               @unique @map("post_id")
  publicKey      String               @map("public_key")
  message        String
  price          String
  coin           Coin                 @default(XEC)
  orderLimitMin  Float                @default(0.0) @map("order_limit_min")
  orderLimitMax  Float                @default(0.0) @map("order_limit_max")
  type           OfferType            @default(SELL)
  paymentMethods OfferPaymentMethod[]
  status         OfferStatus          @default(ACTIVE)
  escrowOrders   EscrowOrder[]
  country        Country?             @relation(fields: [countryId], references: [id])
  countryId      Int?                 @map("country_id")
  state          State?               @relation(fields: [stateId], references: [id])
  stateId        Int?                 @map("state_id")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @default(now()) @map("updated_at") @db.Timestamptz

  @@map("offer")
}

model OfferPaymentMethod {
  id              String        @id @default(cuid())
  offer           Offer         @relation(fields: [offerId], references: [postId])
  offerId         String        @map("offer_id")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int           @map("payment_method_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  @@map("offer_payment_method")
}

model PaymentMethod {
  id                  Int                  @id @default(autoincrement())
  name                String
  message             String?
  offerPaymentMethods OfferPaymentMethod[]
  escrowOrders        EscrowOrder[]
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz

  @@map("payment_method")
}

enum OfferType {
  BUY
  SELL
}

enum OfferStatus {
  ACTIVE
  ARCHIVE
}

enum DisputeStatus {
  ACTIVE
  RESOLVED
}

enum EscrowOrderStatus {
  PENDING
  ACTIVE
  ESCROW
  COMPLETE
  CANCEL
}

enum AddressType {
  P2PKH
  P2SH
}

enum Coin {
  XPI
  XEC
  XRG
}
