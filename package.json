{
  "name": "@bcrpos/lixilotus",
  "version": "0.0.9",
  "private": true,
  "devDependencies": {
    "husky": "^9.0.11",
    "turbo": "1.12.5"
  },
  "scripts": {
    "prepare": "husky install",
    "precommit": "turbo run format",
    "dev:api": "turbo run dev --filter=@bcpros/app-lixi-api",
    "build": "turbo run build --include-dependencies",
    "build:api": "turbo run build --filter=@bcpros/app-lixi-api",
    "db:deploy": "turbo run db:deploy --filter=@bcpros/lixi-prisma",
    "format": "turbo run format"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "packages/**/webpack-dev-server",
      "**/babel-loader",
      "**/babel-jest"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn precommit"
    }
  },
  "resolutions": {
    "@types/react": "<18.0.0",
    "@types/react-dom": "<18.0.0"
  }
}