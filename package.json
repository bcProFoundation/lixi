{
  "name": "@bcrpos/lixi",
  "version": "0.0.9",
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "husky": "^9.1.4",
    "syncpack": "^12.4.0",
    "turbo": "1.13.0"
  },
  "scripts": {
    "prepare": "husky install",
    "precommit": "turbo run format",
    "dev": "turbo run dev --filter=@bcpros/app-lixi",
    "dev:api": "turbo run dev --filter=@bcpros/app-lixi-api",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@bcpros/app-lixi-api",
    "build:app": "turbo run build --filter=@bcpros/app-lixi",
    "db:deploy": "turbo run db:deploy --filter=@bcpros/lixi-prisma",
    "db:seeds": "turbo run db:seeds --filter=@bcpros/lixi-prisma",
    "format": "turbo run format"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm precommit"
    }
  },
  "packageManager": "pnpm@8.15.4"
}